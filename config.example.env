# 复制为 config.env 后填写实际值（config.env 已被 .gitignore 忽略）

# Hostwinds 服务 ID（Cloud 控制台实例详情页 URL 中的 serviceid）
HOSTWINDS_SERVICE_ID="1234567"

# Cloud API key 文件路径
# 在 https://clients.hostwinds.com/api_keys.php 生成，建议绑定服务器 IP 白名单
#   chmod 600 hostwinds.apikey
HOSTWINDS_API_KEY_FILE="$HOME/hostwinds-autoheal/hostwinds.apikey"
